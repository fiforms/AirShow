#!/bin/sh
# airshow-kiosk — run AirShow underneath a fullscreen kiosk browser and hide
# the browser while someone is casting.
#
# Two systemd user units do the work:
#   airshow.service          AirShow, fullscreen, at the bottom
#   airshow-browser.service  the kiosk browser, started after AirShow is on
#                            screen so that it maps on top
# AirShow's --on-session-start/--on-session-end hooks call this script, which
# stops the browser while a sender is connected (revealing AirShow) and starts
# it again afterwards.
#
# Start it from your compositor's autostart (labwc: ~/.config/labwc/autostart):
#   airshow-kiosk start &
#
# Settings: /etc/airshow/kiosk.conf, overridden by ~/.config/airshow/kiosk.conf
set -eu

BROWSER_UNIT=airshow-browser.service
RECEIVER_UNIT=airshow.service
SELF=$(command -v airshow-kiosk 2>/dev/null || echo "$0")
STATE="${XDG_RUNTIME_DIR:-/tmp}/airshow-kiosk.browser-hidden"

load_config() {
    KIOSK_URL="about:blank"
    BROWSER_COMMAND=""
    AIRSHOW_ARGS=""
    for f in /etc/airshow/kiosk.conf "${XDG_CONFIG_HOME:-$HOME/.config}/airshow/kiosk.conf"; do
        # shellcheck disable=SC1090
        if [ -r "$f" ]; then . "$f"; fi
    done
}

usage() {
    cat <<USAGE
Usage: airshow-kiosk COMMAND

  start          start AirShow with the kiosk browser on top (run this from the
                 compositor's autostart; it passes the Wayland session to systemd)
  stop           stop the browser and AirShow
  status         show both units

Used by the systemd units and AirShow itself:
  receiver       run AirShow with the session hooks (airshow.service)
  browser        run the kiosk browser (airshow-browser.service)
  session-start  hide the browser (AirShow --on-session-start)
  session-end    bring the browser back (AirShow --on-session-end)
  raise-browser  restart a running browser so it is on top again
USAGE
}

case "${1:-}" in
start)
    # User units don't inherit the compositor's environment; hand it over.
    vars="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE"
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $vars 2>/dev/null ||
        systemctl --user import-environment $vars
    rm -f "$STATE"
    # The browser unit pulls in airshow.service and waits until it's on screen.
    exec systemctl --user start "$BROWSER_UNIT"
    ;;
stop)
    rm -f "$STATE"
    exec systemctl --user stop "$BROWSER_UNIT" "$RECEIVER_UNIT"
    ;;
status)
    exec systemctl --user --no-pager status "$RECEIVER_UNIT" "$BROWSER_UNIT"
    ;;
receiver)
    load_config
    # shellcheck disable=SC2086
    exec airshow --on-session-start "$SELF session-start" \
                 --on-session-end "$SELF session-end" $AIRSHOW_ARGS
    ;;
browser)
    load_config
    if [ -n "$BROWSER_COMMAND" ]; then
        exec sh -c "$BROWSER_COMMAND"
    fi
    for b in chromium chromium-browser; do
        if command -v "$b" >/dev/null 2>&1; then
            exec "$b" --kiosk --ozone-platform=wayland --noerrdialogs \
                --disable-infobars --no-first-run "$KIOSK_URL"
        fi
    done
    echo "airshow-kiosk: Chromium not found; set BROWSER_COMMAND in kiosk.conf" >&2
    exit 1
    ;;
session-start)
    # Only hide a browser that is running, and remember that we did, so that
    # session-end doesn't start one that was never there.
    if systemctl --user --quiet is-active "$BROWSER_UNIT"; then
        touch "$STATE"
        systemctl --user stop "$BROWSER_UNIT"
    fi
    ;;
session-end)
    if [ -e "$STATE" ]; then
        rm -f "$STATE"
        systemctl --user start --no-block "$BROWSER_UNIT"
    fi
    ;;
raise-browser)
    # airshow.service runs this once AirShow is on screen: after AirShow
    # restarts (e.g. a crash) its window is on top, so put the browser back over it.
    if systemctl --user --quiet is-active "$BROWSER_UNIT"; then
        systemctl --user restart --no-block "$BROWSER_UNIT"
    fi
    ;;
-h|--help|help)
    usage
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
